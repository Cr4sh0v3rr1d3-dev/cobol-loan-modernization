# Nunca commitear un .env real — ver .gitignore (la entrada `.env` ya lo cubre).
# Copiar este archivo a `.env` y completar con valores locales reales antes de
# levantar docker-compose.yml. Los nombres de las variables deben coincidir
# exactamente con los que consume docker-compose.yml (ver comentario al inicio
# de ese archivo).

# --- Postgres (usado por el servicio `postgres` en docker-compose.yml) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=<tu_password_aca>
POSTGRES_DB=cobol_loans

# --- Spring Boot / Datasource (usado por el servicio `api`) ---
# Estos tres se derivan de las variables de Postgres de arriba dentro de
# docker-compose.yml (SPRING_DATASOURCE_URL usa POSTGRES_DB, etc.). Se listan
# acá solo como referencia si se corre `api/` fuera de docker-compose, ej. con
# `./mvnw spring-boot:run` en local contra un Postgres propio.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cobol_loans
SPRING_DATASOURCE_USERNAME=changeme
SPRING_DATASOURCE_PASSWORD=<tu_password_aca>
